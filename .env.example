NODE_ENV=development
PORT=3000

# Railway uses DATABASE_URL; local development can use the split DB_* variables below.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shifthand
DB_USER=root
DB_PASSWORD=

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_SECRET=
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
PUBLIC_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*